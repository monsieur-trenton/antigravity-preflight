{
  "preflight-deny-all": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I -B /review/deny_tools.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
